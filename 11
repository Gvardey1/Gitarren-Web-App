from gpiozero import LED, PWMLED
from time import sleep
from threading import Thread, Event


ruek_licht = PWMLED(22) 
tag_fahr_licht = PWMLED(23) 
right_blue = PWMLED(17) 
left_blue = PWMLED(27)
bremsen_licht = PWMLED(24)
warn_licht = PWMLED(5)


# -------------------------
# Rücklicht
# -------------------------

def ruek_licht_on():
    ruek_licht.value = 0.2

def ruek_licht_off():
    ruek_licht.value = 0

def bremsen_on():
    bremsen_licht.value = 1

def bremsen_off():
    bremsen_licht.value = 0

# -------------------------
# Tagfahrlicht
# -------------------------

def tag_fahr_licht_on():
    tag_fahr_licht.value = 0.3

def tag_fahr_licht_off():
    tag_fahr_licht.value = 0

# -------------------------
# Warnlicht
# -------------------------

_warn_licht_stop = Event()
_warn_licht_thread = None

def _warn_licht_loop():
    while not _warn_licht_stop.is_set():
        warn_licht.on()
        sleep(0.5)
        warn_licht.off()
        sleep(0.5)
    warn_licht.off()

def warn_licht_on():
    global _warn_licht_thread
    if _warn_licht_thread and _warn_licht_thread.is_alive():
        return

    _warn_licht_stop.clear()
    _warn_licht_thread = Thread(target=_warn_licht_loop, daemon=True)
    _warn_licht_thread.start()

def warn_licht_off():
    _warn_licht_stop.set()

_blau_licht_stop = Event()
_blau_licht_thread = None

def _blinken_loop():
    while not _blau_licht_stop.is_set():
        left_blue.blink(on_time=0.1, off_time=0.05, n=2, background=True)
        right_blue.blink(on_time=0.1, off_time=0.05, n=2, background=True)
        sleep(0.5)
        left_blue.blink(on_time=0.1, off_time=0.05, n=2, background=False)
        right_blue.blink(on_time=0.1, off_time=0.05, n=2, background=False)
        sleep(0.1)
        left_blue.off()
        right_blue.off()

def blau_licht_on():
    global _blau_licht_thread
    if _blau_licht_thread and _blau_licht_thread.is_alive():
        return
    
    _blau_licht_stop.clear()
    _blau_licht_thread = Thread(target=_blinken_loop, daemon=True)
    _blau_licht_thread.start()

def blau_licht_off():
    _blau_licht_stop.set()

def sauber():
    blau_licht_off()
    warn_licht_off()
    ruek_licht_off()
    bremsen_off()
    tag_fahr_licht_off()

if __name__ == "__main__":
    try:
        warn_licht_on()
        while True:
            sleep(1)
    except KeyboardInterrupt:
        sauber()
